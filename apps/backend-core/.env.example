# Local uv/Uvicorn configuration (not the root Docker Compose .env).
# Copy to .env when local overrides are needed. Relative paths use apps/backend-core.
# Runtime display title; empty values use whisper-guide.
WHISPER_GUIDE_APP_TITLE=whisper-guide
WHISPER_GUIDE_DATA_DIR=data
WHISPER_GUIDE_BACKUP_DIR=backups
WHISPER_GUIDE_SCRIPT_MAX_FILE_BYTES=2097152
# Multipart parser supports 1–1000 files per request.
WHISPER_GUIDE_SCRIPT_MAX_UPLOAD_FILES=10
# New-session UI default; existing/restored sessions keep their own setting.
# Silence wait in milliseconds: minimum 1000, default 3000.
WHISPER_GUIDE_DEFAULT_SILENCE_TIMEOUT_MS=3000
WHISPER_GUIDE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
WHISPER_GUIDE_SPEECH_MODEL_DIR=models/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20
WHISPER_GUIDE_SPEECH_SAMPLE_RATE=16000
WHISPER_GUIDE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# STT provider: local, hybrid, or any id registered in STT_PROVIDER_CONFIGS.
WHISPER_GUIDE_STT_PROVIDER=local
# JSON array of backend-registered remote providers; keep tokens server-side only.
# Example: [{"id":"provider-a","label":"通用云端模型","endpoint":"https://gateway.example/v1/stt","model":"streaming-model","access_token":"<server-side-token>"}]
# access_token_env reads an exported process variable, not an unrelated dotenv key.
WHISPER_GUIDE_STT_PROVIDER_CONFIGS=[]
# Deprecated single-provider compatibility fields (prefer STT_PROVIDER_CONFIGS).
WHISPER_GUIDE_CLOUD_ENDPOINT=
WHISPER_GUIDE_CLOUD_APP_ID=
WHISPER_GUIDE_CLOUD_ACCESS_TOKEN=
WHISPER_GUIDE_CLOUD_OPT_IN=false

# Semantic LLM alignment (OpenAI-compatible; credentials remain server-side)
WHISPER_GUIDE_LLM_ALIGN_MODE=off
# Provider preset is a UI label; configure BASE_URL and MODEL separately.
WHISPER_GUIDE_LLM_PROVIDER_PRESET=custom
WHISPER_GUIDE_LLM_BASE_URL=
WHISPER_GUIDE_LLM_MODEL=
WHISPER_GUIDE_LLM_API_KEY=
WHISPER_GUIDE_LLM_TIMEOUT_MS=1500
# Independent cloud STT transport settings. Blank credentials remain optional until enabled.
WHISPER_GUIDE_CLOUD_STT_PROTOCOL=http-json
WHISPER_GUIDE_CLOUD_STT_AUTH_MODE=api-key
WHISPER_GUIDE_CLOUD_STT_RESOURCE_ID=volc.seedasr.sauc.duration
WHISPER_GUIDE_CLOUD_STT_TIMEOUT_MS=5000
WHISPER_GUIDE_CLOUD_STT_ENABLE_NONSTREAM=true
WHISPER_GUIDE_CLOUD_STT_ENDPOINT=
WHISPER_GUIDE_CLOUD_STT_APP_ID=
WHISPER_GUIDE_CLOUD_STT_ACCESS_TOKEN=

# Runtime profiles and active snapshot: DATA_DIR/.model-configs.json (0600).
# Legacy .model-settings.json migrates automatically; active profile overrides defaults.
# Never publish either private file. Presets are editable examples, not verified accounts.
