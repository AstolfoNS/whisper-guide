# Display title is read at runtime from backend WHISPER_GUIDE_APP_TITLE (default whisper-guide).
# 默认同源 /api；仅在 API 使用不同公开地址时填写，该值会进入前端构建，不能存放密钥。
VITE_API_BASE_URL=
# 开发/本地预览的代理上游；从此前端目录的 .env / .env.<mode> 读取。
# 已导出的同名进程变量优先；修改后重新启动 Vite，不改变 Docker Nginx 的代理配置。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
